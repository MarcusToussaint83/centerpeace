# ---------- App ----------
# URL the app is reachable at (used for OAuth callbacks, emails, etc.)
APP_URL=http://localhost:3000

# Node environment: development | production | test
NODE_ENV=development

# ---------- Auth (Auth.js v5) ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-32-byte-secret

# ---------- Database ----------
# Postgres connection string. Docker Compose default below; override for hosted DB.
DATABASE_URL=postgres://centerpeace:centerpeace@localhost:5432/centerpeace

# ---------- Storage ----------
# local | s3
STORAGE_MODE=local
# Used when STORAGE_MODE=local
LOCAL_STORAGE_DIR=./data/uploads
# Used when STORAGE_MODE=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------- AI ----------
# solver | api | agent
AI_MODE=solver

# Required when AI_MODE=api
# AI_PROVIDER=anthropic           # anthropic | openai | google | ollama
# AI_MODEL=claude-opus-4-7
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Required when AI_MODE=agent
# AGENT_WORKSPACE_DIR=./.seating-agent
